<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Cap rendering at 60 Hz on ProMotion (120 Hz) displays. The Flutter iOS
	     template ships this key as <true/>, which opts the app into 120 Hz —
	     every scroll, tab transition and pulse then composites at up to twice
	     the frame rate. This is a BLE mesh app whose main complaint is the phone
	     running hot; its animations are slow and decorative (the aurora and the
	     online dots already self-limit to ~30 fps by wall-clock ticker), so
	     120 Hz buys imperceptible smoothness for a real GPU/battery cost. Left
	     explicitly false, with this note, so a future template regen doesn't
	     silently re-enable it. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Cubechat</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>cubechat</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>GoogleMapsApiKey</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- ITSAppUsesNonExemptEncryption is deliberately absent, and that is a
	     retreat rather than an answer.

	     It was `true`, for a reason that still holds: we encrypt messages with
	     our own implementation — Noise handshakes over X25519,
	     ChaCha20-Poly1305, and an in-repo secp256k1 — rather than only calling
	     what iOS provides, and it protects message content rather than just a
	     login. Neither usual exemption covers that, and `false` would be a
	     false declaration.

	     But `true` alone does not upload. On 2026-08-31 App Store Connect
	     refused the build during validation:

	         Validation failed (409) Invalid Export Compliance Code. The export
	         compliance key value [] in the app's Info.plist doesn't match the
	         key value of the app's export compliance documentation.

	     `true` requires a second key, ITSEncryptionExportComplianceCode, which
	     Apple issues once export documentation is on file. That documentation
	     is reached through the encryption questionnaire, and the questionnaire
	     hangs off an uploaded build — so the code cannot be obtained until a
	     build is accepted, and no build is accepted without the code. The App
	     Information page carries no way in either; it was checked.

	     Absent, the question is asked in App Store Connect per build instead,
	     which is answerable and true. Put both keys back together once the
	     code exists — this one without the code is the one combination that
	     cannot ship. -->

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- BLE mesh transport (M1) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Only when you choose to share your location in a chat, or turn on the live map. Cubechat never sends your position anywhere except to the people you send it to.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Keeps your pin current for the contacts you added to your map, including while Cubechat is in the background. Only those contacts receive it, and turning map sharing off removes your pin from their map at once.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Cubechat uses Bluetooth to discover nearby peers and send messages over a local mesh network — no internet needed.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Cubechat advertises itself over Bluetooth so other peers can find your device on the mesh.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cubechat uses your local network only while transferring an encrypted profile between your phones.</string>
	<!-- In-app camera: take a photo to send, and record a round video message -->
	<key>NSCameraUsageDescription</key>
	<string>Cubechat uses the camera to take photos, record round video messages, and scan contact or channel QR codes.</string>
	<!-- Voice messages and the sound on a round video message -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Cubechat needs the microphone to record voice messages and round video messages you send in chats.</string>
	<!-- In-app gallery: pick photos to send, and save received photos -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cubechat needs access to your photos so you can pick images to send in chats.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Cubechat saves photos from your chats to your photo library when you choose to.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<!-- Lets iOS wake us on its own schedule to pull whatever the Nostr
		     relays are holding, so an internet message that arrived while the
		     app was suspended can raise a notification before the user next
		     opens it. Bluetooth needs no such window; the two modes above keep
		     the process alive for radio events. -->
		<string>fetch</string>
		<!-- The live map. Without this, CoreLocation stops delivering the
		     moment the app leaves the screen, and a friend's pin freezes
		     wherever they last had cubechat open. Claimed but not spent: the
		     location manager only starts once somebody turns map sharing on
		     and has friends receiving it, so an install that never opens the
		     map never runs it. -->
		<string>location</string>
	</array>
	<!-- BGTaskScheduler refuses to register an identifier that is not listed
	     here, and throws at launch when the app tries. Must match
	     AppDelegate.refreshTaskId. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.cubechat.relayRefresh</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
