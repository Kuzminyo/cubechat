{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/guard.py || python3 .codex/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/arb_reminder.py || python3 .codex/hooks/arb_reminder.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
