<?xml version="1.0" encoding="utf-8"?>
<!--
    What the hand-off provider may lend out.

    Everything cubechat writes and might pass to another app: the media
    directories under the app's own files (see MediaPaths — photos, voice
    notes, stickers all live there), and the caches an export is staged in.
    Nothing outside them, and read-only per grant.
-->
<paths>
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
    <external-files-path name="external-files" path="." />
    <external-cache-path name="external-cache" path="." />
</paths>
