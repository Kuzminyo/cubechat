# Copy to .env and fill in. Nothing here is secret except the .p8 file itself,
# which is never committed and lives beside the process.

PORT=8080

# The same relays the app publishes to. If these two lists drift, a message
# stored on a relay nobody here is watching wakes nobody.
RELAYS=wss://nos.lol,wss://relay.primal.net

# From the Apple developer account.
#   APNS_KEY_ID   the ten characters in the .p8 filename
#   APNS_TEAM_ID  XGPPT9GNR2
#   APNS_TOPIC    the bundle id, which is the app's and not the extension's
APNS_KEY_ID=
APNS_TEAM_ID=XGPPT9GNR2
APNS_TOPIC=app.cubechat
APNS_KEY_PATH=./AuthKey.p8

# api.sandbox.push.apple.com while the build is a development one. A token
# minted by a development build is refused by production and the other way
# round, and the error for it is BadDeviceToken, which reads like a bug in the
# phone rather than the wrong host.
APNS_HOST=https://api.push.apple.com

STORE_PATH=./tokens.json
