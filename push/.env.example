# Copy to .env and fill in. Nothing here is secret except the .p8 file itself,
# which is never committed and lives beside the process.

PORT=8080

# The same relays the app publishes to. If these two lists drift, a message
# stored on a relay nobody here is watching wakes nobody.
RELAYS=wss://nos.lol,wss://relay.primal.net

# From the Apple developer account.
#   APNS_KEY_ID   the ten characters in the .p8 filename
#   APNS_TEAM_ID  XGPPT9GNR2
#   APNS_TOPIC    the bundle id, which is the app's and not the extension's
APNS_KEY_ID=
APNS_TEAM_ID=XGPPT9GNR2
APNS_TOPIC=app.cubechat
APNS_KEY_PATH=./AuthKey.p8

# A hint, not a setting. A token from a sideloaded or Xcode build belongs to
# sandbox; one from TestFlight or the App Store belongs to production, and each
# host refuses the other's with BadDeviceToken — a message that reads like a
# broken token rather than the wrong address.
#
# The service tries this one first and falls back to the other on exactly that
# error, then remembers which worked for that phone. So put whichever kind of
# build you are testing right now and stop thinking about it; a sideloaded
# phone and a TestFlight phone can be served at the same time, which no single
# value here could do.
APNS_HOST=https://api.push.apple.com

STORE_PATH=./tokens.json
