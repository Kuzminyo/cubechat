# Append this to /etc/caddy/Caddyfile. Do not replace the file: the push
# server's blocks are already in there.
#
# /media has its own strfry process and LMDB. This is what lets the app close
# the media REQ on cellular data without silencing text at the host root.
relay.cubechat.tech {
	handle_path /media* {
		reverse_proxy 127.0.0.1:8082 {
			transport http {
				versions 1.1
				keepalive off
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8081 {
			transport http {
				versions 1.1
				keepalive off
			}
		}
	}
}