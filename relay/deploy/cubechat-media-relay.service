[Unit]
Description=cubechat media relay (strfry)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cubechat-relay
WorkingDirectory=/opt/cubechat-media-relay
ExecStart=/usr/local/bin/strfry --config=/opt/cubechat-media-relay/strfry.conf relay
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cubechat-media-relay

[Install]
WantedBy=multi-user.target